# ==============================================================================
# AcousticSense Backend Environment Configuration
# ==============================================================================

# CORS Origins (Comma-separated list of allowed frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Groq AI Interpretation Configuration
# ------------------------------------------------------------------------------
# Security Notice: This key MUST remain on the backend only.
# It is NEVER exposed to browser requests, client JavaScript, or frontend code.
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Identifier (Default: qwen/qwen3.8-27b)
# Supported alternatives: openai/gpt-oss-120b, openai/gpt-oss-20b, llama-3.3-70b-versatile
GROQ_MODEL=qwen/qwen3.8-27b

# ------------------------------------------------------------------------------
# Scientific Guardrails Note
# ------------------------------------------------------------------------------
# 1. Raw time-series waveform arrays (WAV/CSV samples) are NEVER sent to Groq.
#    Only bounded, derived numerical metrics, spectral peaks, and filter parameters
#    are provided to the model.
# 2. AI interpretation provides educational and engineering explanations of
#    deterministic classical DSP findings. It is not an ISO-certified diagnostic
#    tool nor a replacement for physical machinery inspection.
